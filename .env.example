# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/looloo

# SQL database
DB_DIALECT=mssql
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=
DB_PASS=
DB_NAME=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECT_TIMEOUT=15000
DB_REQUEST_TIMEOUT=15000

# Authentication
# `npm run env:init` replaces these values with cryptographically strong secrets.
JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-strong-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
ENABLE_TEST_TOKEN=false

# OAuth providers
GOOGLE_CLIENT_ID=
MS_CLIENT_ID=
MS_TENANT_ID=

# Kafka
KAFKA_DISABLED=true
KAFKA_CLIENT_ID=looloo-api
KAFKA_BROKERS=
KAFKA_TOPIC_SEND_VERIFICATION=
